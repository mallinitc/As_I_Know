ARCA_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ARCA_LOG_DIR=logs

# Agent 5 defaults to deterministic mode. Enable only for an approved endpoint.
ARCA_LLM_ENABLED=false
# Supported contracts: openai, azure_openai, or openai_compatible
ARCA_LLM_PROVIDER=
# Standard OpenAI defaults to https://api.openai.com when this is empty.
ARCA_LLM_ENDPOINT=
ARCA_LLM_MODEL=
ARCA_LLM_API_KEY=
# Required for azure_openai; leave empty for openai_compatible.
ARCA_LLM_API_VERSION=
ARCA_LLM_TIMEOUT_SECONDS=20
ARCA_LLM_INPUT_MAX_CHARS=30000
ARCA_LLM_MAX_OUTPUT_TOKENS=1200
ARCA_LLM_REASONING_EFFORT=minimal
ARCA_DEMO_PERSONA_MODE=true
ARCA_DEPLOYMENT_ENV=development
