ARCA_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ARCA_LOG_DIR=logs

# Agent 5 defaults to deterministic mode. Enable only for an approved endpoint.
ARCA_LLM_ENABLED=false
# Supported contracts: openai, azure_openai, openai_compatible, or bedrock
ARCA_LLM_PROVIDER=
# bedrock only: uses Amazon Nova Lite (amazon.nova-lite-v1:0 or a us./eu./apac./ca. profile).
# No API key is stored; a short-lived Bedrock key is minted from the standard AWS
# credential chain (environment, profile, SSO, or EC2/ECS role) and replaced before it expires.
ARCA_LLM_AWS_REGION=
ARCA_BEDROCK_TOKEN_TTL_SECONDS=3600
# Standard OpenAI defaults to https://api.openai.com when this is empty.
ARCA_LLM_ENDPOINT=
ARCA_LLM_MODEL=
ARCA_LLM_API_KEY=
# Required for azure_openai; leave empty for openai_compatible.
ARCA_LLM_API_VERSION=
ARCA_LLM_TIMEOUT_SECONDS=20
ARCA_LLM_INPUT_MAX_CHARS=30000
ARCA_LLM_MAX_OUTPUT_TOKENS=1200
ARCA_LLM_REASONING_EFFORT=minimal
# AWS evidence: synthetic (default, local JSON fixtures) or live (CloudTrail and IAM
# for the resources created by scripts/aws_live_testbed.py). Azure and Snowflake are unaffected.
ARCA_AWS_EVIDENCE_SOURCE=synthetic
ARCA_DEMO_PERSONA_MODE=true
ARCA_DEPLOYMENT_ENV=development
