    [Parameter(Mandatory = $true)]
    [string]$Project,                  # e.g. "MyProject"

    [Parameter(Mandatory = $true)]
    [int]$PipelineId,                  # definition id for role-assignment-ado

    [Parameter(Mandatory = $true)]
    [string]$WorkspaceId,              # Log Analytics Workspace ID (GUID)

    [Parameter(Mandatory = $true)]
    [string]$SharedKey,                # Log Analytics primary key (secret variable)

    [string]$LogType      = "AdoPipelineAudit",
    [int]   $LookbackHours = 24
)

# ------------------------
# Helper: Log Analytics ingestion
# ------------------------
function Send-LogAnalyticsData {
    param(
        [Parameter(Mandatory = $true)]
        [string]$CustomerId,   # WorkspaceId

        [Parameter(Mandatory = $true)]
        [string]$SharedKey,    # Workspace primary key

        [Parameter(Mandatory = $true)]
        [string]$LogType,      # Custom table name prefix

        [Parameter(Mandatory = $true)]
        [string]$Body          # JSON string
    )

    $method       = "POST"
    $contentType  = "application/json"
    $resource     = "/api/logs"
    $rfc1123Date  = [DateTime]::UtcNow.ToString("r")
    $bodyBytes    = [Text.Encoding]::UTF8.GetBytes($Body)
    $contentLength = $bodyBytes.Length

    $stringToSign = "$method`n$contentLength`n$contentType`nx-ms-date:$rfc1123Date`n$resource"
    $bytesToHash  = [Text.Encoding]::UTF8.GetBytes($stringToSign)
    $keyBytes     = [Convert]::FromBase64String($SharedKey)

    $hmacSha256          = New-Object System.Security.Cryptography.HMACSHA256
    $hmacSha256.Key      = $keyBytes
    $hash                = $hmacSha256.ComputeHash($bytesToHash)
    $signature           = [Convert]::ToBase64String($hash)
    $authorizationHeader = "SharedKey $CustomerId:$signature"

    $uri = "https://$CustomerId.ods.opinsights.azure.com$resource?api-version=2016-04-01"

    $headers = @{
        "Authorization"        = $authorizationHeader
        "Log-Type"             = $LogType
        "x-ms-date"            = $rfc1123Date
        "time-generated-field" = ""   # use ingestion time
    }

    Write-Host "Sending $($contentLength) bytes to Log Analytics table ${LogType}_CL ..."
    $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $Body -ContentType $contentType
    Write-Host "Log Analytics ingest status code: $($response.StatusCode) (ignore if not present; LA often returns empty body)"
}

