# Given: $a.Scope and $a.RoleAssignmentId from Get-AzRoleAssignment
# RoleAssignmentId is typically the GUID name of the role assignment resource.

$apiVersion = "2022-04-01"
$roleAssignName = $a.RoleAssignmentId

$restPath = "$($a.Scope)/providers/Microsoft.Authorization/roleAssignments/$roleAssignName?api-version=$apiVersion"

try {
    $resp = Invoke-AzRestMethod -Method GET -Path $restPath -ErrorAction Stop
    $json = $resp.Content | ConvertFrom-Json

    $createdOn = $json.properties.createdOn
    $createdBy = $json.properties.createdBy
}
catch {
    $createdOn = $null
    $createdBy = $null
}