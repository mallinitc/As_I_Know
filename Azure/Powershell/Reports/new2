function Resolve-UpnToDisplayNameOrKeep {
    param(
        [string]$UpnOrMail,
        [string]$GraphToken
    )

    if ([string]::IsNullOrWhiteSpace($UpnOrMail)) { return $UpnOrMail }

    $headers = @{ Authorization = "Bearer $GraphToken" }

    # Try UPN
    try {
        $uri = "https://graph.microsoft.com/v1.0/users/$([uri]::EscapeDataString($UpnOrMail))?`$select=displayName,userPrincipalName,mail"
        $u = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        if ($u.displayName) { return $u.displayName }
    } catch {}

    # Try mail filter (covers cases where createdBy is email but not UPN)
    try {
        $filter = [uri]::EscapeDataString("mail eq '$UpnOrMail'")
        $uri = "https://graph.microsoft.com/v1.0/users?`$filter=$filter&`$select=displayName,mail&`$top=1"
        $r = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        if ($r.value -and $r.value[0].displayName) { return $r.value[0].displayName }
    } catch {}

    return $UpnOrMail
}







